import { getStreams as getAnikotoStreams } from "./anikoto.js";

const PROVIDER_TIMEOUT_MS = 8000;
const TMDB_API_KEY = "68e094699525b18a70bab2f86b1fa706";

// ---------------------------------------------------------
// Helper: IMDb -> TMDB
// ---------------------------------------------------------

async function imdbToTmdb(imdbId, type) {
  try {
    const mediaType = type === "movie" ? "movie" : "tv";
    const url = `https://api.themoviedb.org/3/find/${encodeURIComponent(imdbId)}?external_source=imdb_id&api_key=${TMDB_API_KEY}`;
    
    const res = await fetch(url);
    if (!res.ok) return null;
    
    const data = await res.json();
    const results = mediaType === "movie" ? data.movie_results : data.tv_results;
    
    if (Array.isArray(results) && results.length > 0 && results[0].id) {
      return String(results[0].id);
    }
    return null;
  } catch (error) {
    console.error(`[ANIME] IMDb->TMDB failed for ${imdbId}:`, error?.message || error);
    return null;
  }
}

// ---------------------------------------------------------
// Helper: Wrap provider in a timeout
// ---------------------------------------------------------

async function withTimeout(name, fn, args) {
  const started = Date.now();
  
  try {
    const result = await Promise.race([
      fn(args),
      new Promise((_, reject) =>
        setTimeout(() => reject(new Error("Timeout")), PROVIDER_TIMEOUT_MS)
      )
    ]);
    
    const elapsed = Date.now() - started;
    const count = Array.isArray(result) ? result.length : 0;
    
    if (count > 0) {
      console.log(`[ANIME] ${name} succeeded in ${elapsed}ms (${count} streams)`);
    } else {
      console.log(`[ANIME] ${name} returned 0 streams in ${elapsed}ms`);
    }
    
    return Array.isArray(result) ? result : [];
  } catch (error) {
    const elapsed = Date.now() - started;
    console.log(`[ANIME] ${name} failed in ${elapsed}ms: ${error?.message || error}`);
    return [];
  }
}

// ---------------------------------------------------------
// Main Entry Point
// ---------------------------------------------------------

export async function getStreams({ imdbId, type, season, episode }) {
  if (!imdbId) return [];

  // Convert IMDb to TMDB before running providers
  const tmdbId = await imdbToTmdb(imdbId, type);
  if (!tmdbId) {
    console.log(`[ANIME] Could not resolve TMDB ID for IMDb ${imdbId}`);
    return [];
  }

  const providers = [
    { name: "Anikoto", fn: getAnikotoStreams },
    // { name: "Zoko", fn: getZokoStreams },
    // { name: "Lee", fn: getLeeStreams },
  ];

  if (providers.length === 0) {
    return [];
  }

  // Run all providers in parallel, passing the TMDB ID
  const results = await Promise.all(
    providers.map((p) => 
      withTimeout(p.name, p.fn, { tmdbId, type, season, episode })
    )
  );

  // Flatten and dedupe
  const flat = results.flat();
  const seen = new Set();
  
  const deduped = flat.filter((stream) => {
    if (!stream || !stream.url) return false;
    if (seen.has(stream.url)) return false;
    seen.add(stream.url);
    return true;
  });

  return deduped;
}
